<script>
  (function () {
    const section = document.querySelector('.product-hotspot-grid');

    if (!section) return;

    const modal = section.querySelector('[data-product-modal]');
    const hotspots = section.querySelectorAll('[data-product-trigger]');

    let activeProduct = null;

    hotspots.forEach(function (hotspot) {
      hotspot.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();

        const id = hotspot.dataset.productTrigger;

        openProduct(id);
      });
    });

    function openProduct(id) {
      const product = section.querySelector('[data-product-content="' + id + '"]');

      if (!product) return;

      section.querySelectorAll('[data-product-content]').forEach(function (item) {
        item.hidden = true;
      });

      product.hidden = false;

      activeProduct = product;

      modal.classList.add('is-open');

      modal.setAttribute('aria-hidden', 'false');

      document.body.classList.add('product-hotspot-grid-modal-open');

      initializeProduct(product);
    }

    function initializeProduct(product) {
      const jsonElement = product.querySelector('script[type="application/json"]');

      if (!jsonElement) return;

      try {
        product.productData = JSON.parse(jsonElement.textContent);
      } catch (error) {
        return;
      }

      product.querySelectorAll('.product-hotspot-grid__color-pills').forEach(function (group) {
        const pills = group.querySelectorAll('[data-option-value]');

        pills.forEach(function (pill) {
          pill.classList.remove('is-selected');
        });

        if (pills.length) {
          pills[0].classList.add('is-selected');
        }
      });

      product.querySelectorAll('.product-hotspot-grid__custom-select').forEach(function (select) {
        select.classList.remove('is-open');

        const options = select.querySelectorAll('.product-hotspot-grid__custom-option');

        const selectedValue = select.querySelector('.product-hotspot-grid__selected-value');

        options.forEach(function (option) {
          option.classList.remove('is-selected');
        });

        if (options.length) {
          options[0].classList.add('is-selected');

          if (selectedValue) {
            selectedValue.textContent = options[0].dataset.optionValue;
          }
        }
      });

      updateVariant(product);
    }

    section.addEventListener('click', function (event) {
      const colorPill = event.target.closest('.product-hotspot-grid__color-pill');

      if (colorPill && activeProduct) {
        const group = colorPill.closest('[data-option-index]');

        if (!group) return;

        group.querySelectorAll('.product-hotspot-grid__color-pill').forEach(function (item) {
          item.classList.remove('is-selected');
        });

        colorPill.classList.add('is-selected');

        updateVariant(activeProduct);

        return;
      }

      const dropdownButton = event.target.closest('.product-hotspot-grid__custom-select-button');

      if (dropdownButton && activeProduct) {
        event.stopPropagation();

        const dropdown = dropdownButton.closest('.product-hotspot-grid__custom-select');

        if (!dropdown) return;

        section.querySelectorAll('.product-hotspot-grid__custom-select.is-open').forEach(function (openDropdown) {
          if (openDropdown !== dropdown) {
            openDropdown.classList.remove('is-open');
          }
        });

        dropdown.classList.toggle('is-open');

        return;
      }

      const dropdownOption = event.target.closest('.product-hotspot-grid__custom-option');

      if (dropdownOption && activeProduct) {
        event.stopPropagation();

        const dropdown = dropdownOption.closest('.product-hotspot-grid__custom-select');

        if (!dropdown) return;

        const selectedValue = dropdown.querySelector('.product-hotspot-grid__selected-value');

        dropdown.querySelectorAll('.product-hotspot-grid__custom-option').forEach(function (option) {
          option.classList.remove('is-selected');
        });

        dropdownOption.classList.add('is-selected');

        if (selectedValue) {
          selectedValue.textContent = dropdownOption.dataset.optionValue;
        }

        dropdown.classList.remove('is-open');

        updateVariant(activeProduct);

        return;
      }

      const addButton = event.target.closest('[data-add-to-cart]');

      if (addButton && activeProduct) {
        addToCart(addButton);

        return;
      }
    });

    function getSelectedVariant(product) {
      const data = product.productData;

      if (!data) return null;

      const selectedOptions = [];

      product.querySelectorAll('[data-option-value].is-selected').forEach(function (option) {
        const group = option.closest('[data-option-index]');

        if (!group) return;

        const index = parseInt(group.dataset.optionIndex, 10);

        selectedOptions[index] = option.dataset.optionValue;
      });

      product.querySelectorAll('.product-hotspot-grid__custom-select').forEach(function (select) {
        const index = parseInt(select.dataset.optionIndex, 10);

        const selectedOption = select.querySelector('.product-hotspot-grid__custom-option.is-selected');

        if (selectedOption) {
          selectedOptions[index] = selectedOption.dataset.optionValue;
        }
      });

      data.options.forEach(function (option, index) {
        if (selectedOptions[index]) return;

        const values = [];

        data.variants.forEach(function (variant) {
          const value = variant.options[index];

          if (value && !values.includes(value)) {
            values.push(value);
          }
        });

        if (values.length) {
          selectedOptions[index] = values[0];
        }
      });

      return (
        data.variants.find(function (variant) {
          return variant.options.every(function (value, index) {
            return value === selectedOptions[index];
          });
        }) || null
      );
    }

    function updateVariant(product) {
      const variant = getSelectedVariant(product);

      product.currentVariant = variant;

      const price = product.querySelector('[data-price]');

      const addButton = product.querySelector('[data-add-to-cart]');

      const errorMessage = product.querySelector('[data-product-error]');

      if (errorMessage) {
        errorMessage.textContent = '';
      }

      if (!variant) {
        if (addButton) {
          addButton.disabled = true;

          addButton.querySelector('span').textContent = 'UNAVAILABLE';
        }

        return;
      }

      if (price) {
        price.textContent = variant.priceFormatted;
      }

      if (addButton) {
        addButton.disabled = !variant.available;

        addButton.querySelector('span').textContent = variant.available ? 'ADD TO CART' : 'SOLD OUT';
      }
    }

    function addToCart(button) {
      const variant = activeProduct.currentVariant;

      const errorMessage = activeProduct.querySelector('[data-product-error]');

      if (!variant || !variant.available) {
        if (errorMessage) {
          errorMessage.textContent = 'Please select an available variant.';
        }

        return;
      }

      button.disabled = true;

      button.querySelector('span').textContent = 'ADDING...';

      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({
          items: [
            {
              id: variant.id,
              quantity: 1,
            },
          ],
        }),
      })
        .then(function (response) {
          if (!response.ok) {
            throw new Error('Unable to add product.');
          }

          return response.json();
        })
        .then(function () {
          button.querySelector('span').textContent = 'ADDED';

          document.dispatchEvent(
            new CustomEvent('cart:refresh', {
              bubbles: true,
            })
          );

          const cartDrawer = document.querySelector('cart-drawer');

          if (cartDrawer && typeof cartDrawer.open === 'function') {
            setTimeout(function () {
              cartDrawer.open();
            }, 150);
          }

          setTimeout(function () {
            button.disabled = false;

            button.querySelector('span').textContent = 'ADD TO CART';
          }, 1200);
        })
        .catch(function () {
          if (errorMessage) {
            errorMessage.textContent = 'Something went wrong. Please try again.';
          }

          button.disabled = false;

          button.querySelector('span').textContent = 'ADD TO CART';
        });
    }

    section.querySelectorAll('[data-modal-close]').forEach(function (element) {
      element.addEventListener('click', function () {
        closeModal();
      });
    });

    function closeModal() {
      modal.classList.remove('is-open');

      modal.setAttribute('aria-hidden', 'true');

      document.body.classList.remove('product-hotspot-grid-modal-open');

      section.querySelectorAll('.product-hotspot-grid__custom-select.is-open').forEach(function (dropdown) {
        dropdown.classList.remove('is-open');
      });

      activeProduct = null;
    }

    document.addEventListener('click', function (event) {
      if (!event.target.closest('.product-hotspot-grid__custom-select')) {
        section.querySelectorAll('.product-hotspot-grid__custom-select.is-open').forEach(function (dropdown) {
          dropdown.classList.remove('is-open');
        });
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        section.querySelectorAll('.product-hotspot-grid__custom-select.is-open').forEach(function (dropdown) {
          dropdown.classList.remove('is-open');
        });

        closeModal();
      }
    });
  })();
</script>

