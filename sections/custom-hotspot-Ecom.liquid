<section
  class="product-hotspot-grid"
  style="padding-top:{{ section.settings.top }}px; padding-bottom:{{ section.settings.btm }}px"
>
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="product-hotspot-grid__header">
        <h2 class="product-hotspot-grid__heading">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    <div class="product-hotspot-grid__grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        {% if product != blank %}
          <div
            class="product-hotspot-grid__item"
            {{ block.shopify_attributes }}
          >
            <div class="product-hotspot-grid__image-wrapper">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    class: 'product-hotspot-grid__image',
                    widths: '375, 550, 750, 1000, 1200'
                }}
              {% elsif product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    class: 'product-hotspot-grid__image',
                    widths: '375, 550, 750, 1000, 1200'
                }}
              {% endif %}

              <button
                type="button"
                class="product-hotspot-grid__hotspot"
                data-product-trigger="{{ block.id }}"
                style="top: {{ block.settings.hotspot_top }}%; left: {{ block.settings.hotspot_left }}%;"
                aria-label="View {{ product.title | escape }}"
              >
                {% if block.settings.custom_svg != blank %}
                  {{ block.settings.custom_svg }}
                {% else %}
                  <img
                    class="product-hotspot-grid__icon"
                    src="https://cdn.shopify.com/s/files/1/1015/8971/3186/files/Component_151.png?v=1787941287"
                  >
                {% endif %}
              </button>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div
    class="product-hotspot-grid__modal"
    data-product-modal
    aria-hidden="true"
  >
    <div
      class="product-hotspot-grid__modal-overlay"
      data-modal-close
    ></div>

    <div
      class="product-hotspot-grid__modal-container"
      role="dialog"
      aria-modal="true"
    >
      <button
        type="button"
        class="product-hotspot-grid__modal-close"
        data-modal-close
        aria-label="Close"
      >
        <svg viewBox="0 0 24 24">
          <path d="M6 6L18 18M18 6L6 18"/>
        </svg>
      </button>

      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        {% if product != blank %}
          <div
            class="product-hotspot-grid__product"
            data-product-content="{{ block.id }}"
            hidden
          >
            <div class="product-hotspot-grid__modal-top">
              <div class="product-hotspot-grid__modal-image">
                {% if product.featured_image != blank %}
                  {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
                {% endif %}
              </div>

              <div class="product-hotspot-grid__modal-info">
                <h2>{{ product.title }}</h2>

                <div
                  class="product-hotspot-grid__modal-price"
                  data-price
                >
                  {{ product.price | money }}
                </div>

                {% if product.description != blank %}
                  <div class="product-hotspot-grid__description">
                    {{ product.description | truncate : 140 }}
                  </div>
                {% endif %}
              </div>
            </div>

            <div class="product-hotspot-grid__variants">
              {% for option in product.options_with_values %}
                {% assign option_name = option.name | downcase %}

                {% if option_name contains 'color' or option_name contains 'colour' %}
                  <div class="product-hotspot-grid__option">
                    <label>
                      {{ option.name }}
                    </label>

                    <div
                      class="product-hotspot-grid__color-pills"
                      data-option-index="{{ forloop.index0 }}"
                    >
                      {% for value in option.values %}
                        <button
                          type="button"
                          class="product-hotspot-grid__color-pill{% if forloop.first %} is-selected{% endif %}"
                          data-option-value="{{ value | escape }}"
                        >
                          {{ value }}
                        </button>
                      {% endfor %}
                    </div>
                  </div>

                {% elsif option_name contains 'size' %}
                  <div class="product-hotspot-grid__option">
                    <label>
                      {{ option.name }}
                    </label>

                    <div
                      class="product-hotspot-grid__custom-select"
                      data-option-index="{{ forloop.index0 }}"
                    >
                      <button
                        type="button"
                        class="product-hotspot-grid__custom-select-button"
                      >
                        <span class="product-hotspot-grid__selected-value"> Choose your size </span>

                        <svg
                          class="product-hotspot-grid__select-arrow"
                          width="15"
                          height="9"
                          viewBox="0 0 15 9"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path d="M1.06067 1.06067L7.06067 7.06067L13.0607 1.06067" stroke="currentcolor" stroke-width="1.5" stroke-linecap="square"/>
                        </svg>
                      </button>

                      <div class="product-hotspot-grid__custom-options">
                        {% for value in option.values %}
                          <button
                            type="button"
                            class="product-hotspot-grid__custom-option"
                            data-option-value="{{ value | escape }}"
                          >
                            {{ value }}
                          </button>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                {% else %}
                  <div class="product-hotspot-grid__option">
                    <label>
                      {{ option.name }}
                    </label>

                    <div class="product-hotspot-grid__select">
                      <select
                        data-option-index="{{ forloop.index0 }}"
                      >
                        {% for value in option.values %}
                          <option value="{{ value | escape }}">
                            {{ value }}
                          </option>
                        {% endfor %}
                      </select>

                      <svg viewBox="0 0 24 24">
                        <path d="M6 9L12 15L18 9"/>
                      </svg>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            <div class="product-hotspot-grid__modal-bottom">
              <button
                type="button"
                class="product-hotspot-grid__add"
                data-add-to-cart
              >
                <span>ADD TO CART</span>

                <svg width="36" height="12" viewBox="0 0 36 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0.75 4.77295L9.20657e-08 4.77295L-9.20657e-08 6.27295L0.75 6.27295L0.75 4.77295ZM34.9798 6.05328C35.2727 5.76039 35.2727 5.28551 34.9798 4.99262L30.2068 0.21965C29.9139 -0.0732432 29.4391 -0.0732433 29.1462 0.21965C28.8533 0.512544 28.8533 0.987417 29.1462 1.28031L33.3888 5.52295L29.1462 9.76559C28.8533 10.0585 28.8533 10.5334 29.1462 10.8263C29.4391 11.1191 29.9139 11.1191 30.2068 10.8263L34.9798 6.05328ZM0.75 6.27295L34.4495 6.27295L34.4495 4.77295L0.75 4.77295L0.75 6.27295Z" fill="currentcolor"/>
                </svg>
              </button>

              <div
                class="product-hotspot-grid__error"
                data-product-error
              ></div>
            </div>

            <script type="application/json">
              {
                "id": {{ product.id | json }},
                "handle": {{ product.handle | json }},
                "options": {{ product.options | json }},
                "variants": [
                  {% for variant in product.variants %}
                    {
                      "id": {{ variant.id | json }},
                      "available": {{ variant.available | json }},
                      "price": {{ variant.price | json }},
                      "priceFormatted": {{ variant.price | money | json }},
                      "options": {{ variant.options | json }}
                    }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ]
              }
            </script>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

