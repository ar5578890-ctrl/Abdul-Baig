{% liquid
  assign overlay_position = section.settings.overlay_position
%}

<section
  class="custom-banner-section"
  id="CustomBanner-{{ section.id }}"
>
  <div class="page-width">
    <div class="custom-banner__inner">
      <div class="custom-banner__top">
        <div class="cstm_banner_top_inner">
          <div class="cstm_hamburger">
            <span class="burger_icon">
              <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 6H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M1 1H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M1 11H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="cross_icon">
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 13.9994L13.7279 1.27147" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M1 1L13.7279 13.7279" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>

          <div class="custom-banner__logo">
            {% if section.settings.logo != blank %}
              <a href="{{ routes.root_url }}">
                {{
                  section.settings.logo
                  | image_url: width: 400
                  | image_tag: loading: 'lazy', widths: '100, 200, 300, 400', class: 'custom-banner__logo-image'
                }}
              </a>
            {% endif %}
          </div>
          <div class="cstm_mobile_cont">
            <div class="custom-banner__top-text">
              {% if section.settings.top_text != blank %}
                {{ section.settings.top_text }}
              {% endif %}
            </div>

            <div class="custom-banner__top-button">
              {% if section.settings.top_button_text != blank %}
                <a
                  href="{{ section.settings.top_button_link }}"
                  class="custom-banner__button custom-banner__button--top"
                >
                  <span>{{ section.settings.top_button_text }}</span>

                  {% if section.settings.top_button_icon != blank %}
                    <span class="custom-banner__button-icon">
                      {{ section.settings.top_button_icon }}
                    </span>
                  {% endif %}
                </a>
              {% endif %}
            </div>
          </div>

          <div class="custom-banner__top-text desk">
            {% if section.settings.top_text != blank %}
              {{ section.settings.top_text }}
            {% endif %}
          </div>

          <div class="custom-banner__top-button desk">
            {% if section.settings.top_button_text != blank %}
              <a
                href="{{ section.settings.top_button_link }}"
                class="custom-banner__button custom-banner__button--top"
              >
                <span>{{ section.settings.top_button_text }}</span>

                {% if section.settings.top_button_icon != blank %}
                  <span class="custom-banner__button-icon">
                    {{ section.settings.top_button_icon }}
                  </span>
                {% endif %}
              </a>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="custom-banner__image-wrapper">
        <div class="ban_wrap_inner">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 2400
              | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000, 2400', class: 'custom-banner__image'
            }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'custom-banner__image custom-banner__image--placeholder' }}
          {% endif %}
          <div class="bann_content">
            <div class="custom-banner__content custom-banner__content--{{ overlay_position }}">
              {% if section.settings.heading != blank %}
                <h2 class="custom-banner__heading">
                  {{ section.settings.heading }}
                </h2>
              {% endif %}

              {% if section.settings.description != blank %}
                <div class="custom-banner__description desk">
                  {{ section.settings.description }}
                </div>
                <div class="custom-banner__description mob">
                  {{ section.settings.description | truncatewords: 7 }}
                </div>
              {% endif %}

              {% if section.settings.button_text != blank %}
                <a
                  href="{{ section.settings.button_link }}"
                  class="custom-banner__button custom-banner__button--content"
                >
                  <span>{{ section.settings.button_text }}</span>

                  {% if section.settings.button_icon != blank %}
                    <span class="custom-banner__button-icon">
                      {{ section.settings.button_icon }}
                    </span>
                  {% endif %}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
      {% if section.settings.btm != blank %}
        <div class="cstm_banner_btm">
          <p>{{ section.settings.btm }}</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Banner - Ecom",
  "tag": "section",
  "class": "custom-banner",
  "settings": [
    {
      "type": "header",
      "content": "Top Row"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "richtext",
      "id": "top_text",
      "label": "Center Text",
      "default": "<p>Center text goes here</p>"
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Button Link"
    },
    {
      "type": "html",
      "id": "top_button_icon",
      "label": "Button SVG / Icon",
      "info": "Paste your SVG code here."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "header",
      "content": "Overlay Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Your description goes here.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "html",
      "id": "button_icon",
      "label": "Button SVG / Icon",
      "info": "Paste your SVG code here."
    },
    {
      "type": "text",
      "label": "Bottom Text",
      "id": "btm"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner - Ecom"
    }
  ]
}
{% endschema %}

<script>
  document.querySelector('.cstm_hamburger').addEventListener('click', function () {
    this.classList.toggle('active');

    const menu = document.querySelector('.cstm_mobile_cont');

    if (menu.style.maxHeight) {
      menu.style.maxHeight = null;
    } else {
      menu.style.maxHeight = menu.scrollHeight + 'px';
    }
  });
</script>
