<style>
        .custom-banner-section .page-width {
          max-width: 100%;
          background: #f5f5f5;
          padding:0
      }
      .cstm_banner_top_inner {
          display: grid;
          justify-content: space-between;
          align-items: center;
          padding: 10px 0;
          grid-template-columns: 1fr 1fr 1fr;
      }

      .custom-banner__top-text p {
          color: #000;
          text-align: center;
          margin: 0;
          font-size: 20px;
          line-height: 35px;
      }

      .custom-banner__logo a {
          display: flex;
      }

      img.custom-banner__logo-image {
          width: 100%;
          max-width: 200px;
      }

      .custom-banner__top-button a {
          display: flex;
          position: relative;
          color: black;
          overflow: hidden;
          justify-content: center;
          align-items: center;
          transition: 0.3s;
          background: #FFF544;
          min-height: 60px;
          line-height: 1;
          padding: 10px 45px;
          font-size: 16px;
          text-transform: uppercase;
          text-decoration: none;
          gap: 15px;
      }
  .cstm_hamburger {
      display: none;
  }

  .cstm_mobile_cont {
      display: none;
  }
      span.custom-banner__button-icon {
          display: flex;
          max-width: 30px;
      }

      .custom-banner__top-button {
          width: 100%;
          display: flex;
          justify-content: end;
      }
      .custom-banner__top {
          max-width: 1600px;
          padding: 0 15px;
          margin: 0 auto;
      }
      .custom-banner__top-button a:before {
             content: "";
          display: block;
          position: absolute;
          width: 100%;
          top: 0;
          bottom: 0;
          right: 0;
          background: #000000;
          z-index: 1;
          transform: translateX(-101%);
          transition: transform 350ms ease;

      }

      .custom-banner__top-button a:hover {
          color: white;
      }

      a.custom-banner__button span {
          z-index: 5;
          position: relative;
          transition: color 350ms ease;
      }

      .custom-banner__top-button a:hover:before {
          transform: translateX(0);
      }


